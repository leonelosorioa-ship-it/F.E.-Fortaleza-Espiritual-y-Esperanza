rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'activeRole', 'currentDay', 'hasFullAccess', 'lastLoginAt', 'loginCount', 'storageQuotaUsedBytes', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('activeRole' in data) || (data.activeRole is string && data.activeRole.size() <= 64)) &&
             (!('currentDay' in data) || (data.currentDay is number && data.currentDay >= 1 && data.currentDay <= 30)) &&
             (!('hasFullAccess' in data) || (data.hasFullAccess is bool)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64)) &&
             (!('loginCount' in data) || (data.loginCount is number && data.loginCount >= 0)) &&
             (!('storageQuotaUsedBytes' in data) || (data.storageQuotaUsedBytes is number && data.storageQuotaUsedBytes >= 0));
    }

    // Login Log Audit Validation
    function isValidLoginLog(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'email', 'providerId', 'loginTime']) &&
             data.keys().hasOnly(['id', 'userId', 'email', 'providerId', 'loginTime', 'device', 'userAgent', 'status', 'createdAt']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.providerId is string && data.providerId.size() <= 64 &&
             data.loginTime is string && data.loginTime.size() <= 64 &&
             (!('device' in data) || (data.device is string && data.device.size() <= 64)) &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 256)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 32)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User File & Devotional Recording Validation
    function isValidUserFile(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'fileType', 'sizeBytes', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'fileType', 'mimeType', 'sizeBytes', 'category', 'description', 'dataUrl', 'createdAt']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 160 &&
             data.fileType in ['audio', 'pdf', 'image', 'document', 'other'] &&
             data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 2500000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('dataUrl' in data) || (data.dataUrl is string && data.dataUrl.size() <= 2000000));
    }

    // Saved Anchor Validation
    function isValidSavedAnchor(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'dateISO', 'symptomId', 'symptomLabel', 'scriptureRef', 'declaration']) &&
             data.keys().hasOnly(['id', 'userId', 'dateISO', 'displayDate', 'roleProfile', 'symptomId', 'symptomLabel', 'userReflection', 'scriptureRef', 'declaration', 'createdAt']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.dateISO is string && data.dateISO.size() <= 64 &&
             data.symptomId is string && data.symptomId.size() <= 64 &&
             data.symptomLabel is string && data.symptomLabel.size() <= 128 &&
             data.scriptureRef is string && data.scriptureRef.size() <= 128 &&
             data.declaration is string && data.declaration.size() <= 1000 &&
             (!('userReflection' in data) || (data.userReflection is string && data.userReflection.size() <= 2000)) &&
             (!('displayDate' in data) || (data.displayDate is string && data.displayDate.size() <= 100)) &&
             (!('roleProfile' in data) || (data.roleProfile is string && data.roleProfile.size() <= 64));
    }

    // Gratitude Entry Validation
    function isValidGratitudeEntry(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'dateISO', 'items']) &&
             data.keys().hasOnly(['id', 'userId', 'dateISO', 'displayDate', 'items', 'createdAt']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.dateISO is string && data.dateISO.size() <= 64 &&
             data.items is list && data.items.size() <= 5 &&
             (data.items.size() == 0 || data.items[0] is string) &&
             (!('displayDate' in data) || (data.displayDate is string && data.displayDate.size() <= 100));
    }

    // Chat Message Validation
    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content', 'timestamp']) &&
             data.keys().hasOnly(['id', 'userId', 'role', 'content', 'mentor', 'timestamp']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.role in ['user', 'model'] &&
             data.content is string && data.content.size() <= 4000 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             (!('mentor' in data) || (data.mentor is string && data.mentor.size() <= 32));
    }

    // Match rules for Users and nested subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket reads are strictly denied

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       isValidUserProfile(incoming(), userId);

      allow delete: if isOwner(userId);

      // Subcollection: Saved Anchors
      match /savedAnchors/{anchorId} {
        allow get: if isOwner(userId) && isValidId(anchorId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(anchorId) &&
                         isValidSavedAnchor(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(anchorId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         isValidSavedAnchor(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(anchorId);
      }

      // Subcollection: Gratitude Entries
      match /gratitudeEntries/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidGratitudeEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(entryId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         isValidGratitudeEntry(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      // Subcollection: Chat History (Multi-turn Gemini Chat)
      match /chatHistory/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         isValidChatMessage(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      // Subcollection: Google Login Logs
      match /loginLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidLoginLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         isValidLoginLog(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Subcollection: Devotional Files & Recorded Audio Prayers
      match /userFiles/{fileId} {
        allow get: if isOwner(userId) && isValidId(fileId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(fileId) &&
                         isValidUserFile(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(fileId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         isValidUserFile(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(fileId);
      }
    }
  }
}
